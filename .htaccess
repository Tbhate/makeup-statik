RewriteEngine On

# --- Custom 404 page ---
ErrorDocument 404 /404.html

# --- Canonical host: force https:// and the bare (non-www) katimaestro.com domain ---
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.katimaestro\.com$ [NC]
RewriteRule ^ https://katimaestro.com%{REQUEST_URI} [L,R=301]

# --- Root domain -> default language (English) ---
RewriteRule ^$ /en/ [R=301,L]

# --- Old flat .html URLs -> new localized clean URLs (301, permanent) ---
RewriteRule ^index\.html$ /en/ [R=301,L]
RewriteRule ^service\.html$ /en/service/ [R=301,L]
RewriteRule ^about\.html$ /en/about/ [R=301,L]
RewriteRule ^portfolio\.html$ /en/portfolio/ [R=301,L]
RewriteRule ^gallery\.html$ /en/gallery/ [R=301,L]
RewriteRule ^offer\.html$ /en/offer/ [R=301,L]
RewriteRule ^privacypolity\.html$ /en/privacy-policy/ [R=301,L]

# --- Directory index for the clean /lang/page/ URLs ---
DirectoryIndex index.html

# --- Keep the admin panel out of search results ---
<Files "admin.html">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</Files>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Browser caching for static assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
